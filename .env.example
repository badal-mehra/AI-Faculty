GEMINI_API_KEY=
GROQ_API_KEY=
# Mistral is the THIRD / final fallback provider (after Gemini, then Groq).
# Server-side only: never expose these to the browser or any client component.
MISTRAL_API_KEY=
# Overridable so the model can be swapped or A/B tested without a code change.
MISTRAL_MODEL=mistral-small-latest
