# Supabase Configuration
# Create a Supabase project at https://supabase.com and copy these values:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AI Teaching Providers (server-side only)
GEMINI_API_KEY=
GROQ_API_KEY=
# Third / final fallback provider (after Gemini, then Groq).
# Server-side only: never expose these to the browser or any client component.
MISTRAL_API_KEY=
# Overridable so the model can be swapped or A/B tested without a code change.
MISTRAL_MODEL=mistral-small-latest